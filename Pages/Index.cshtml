@page
@model IndexModel
@{
    ViewData["Title"] = "首頁";
}

<section class="text-center py-5 my-4" aria-labelledby="home-title">
    <p class="text-primary fw-semibold text-uppercase mb-2">世界時間</p>
    <h1 id="home-title" class="display-4 fw-bold">現在時間，一眼掌握</h1>
    <p class="lead text-secondary mt-3 mb-4">查看此刻時間，並切換至常用時區。</p>
    <a class="btn btn-primary btn-lg px-4" asp-page="/Clock">現在時間</a>
    <a class="btn btn-outline-primary btn-lg px-4 ms-2" asp-page="/Pomodoro">番茄鐘</a>
</section>
